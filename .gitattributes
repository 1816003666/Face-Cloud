# Deterministic checkouts on Windows and Linux.
* text=auto eol=lf

*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
*.sh text eol=lf
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.lock text eol=lf

# Binary files must never be normalized or presented as text diffs.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.docx binary
*.xlsx binary
*.pptx binary
*.zip binary
*.7z binary
*.tar binary
*.gz binary
*.apk binary
*.exe binary
*.dll binary
*.pyd binary
*.so binary
*.node binary
*.jar binary
*.img binary
*.iso binary
*.db binary
*.db-wal binary
*.db-shm binary
*.sqlite binary
*.sqlite3 binary
*.mp4 binary
*.mkv binary
*.onnx binary
*.ckpt binary
*.safetensors binary
