# 复制为 .env 后修改。生产环境务必改掉带 * 的默认值。

# 基础
SECRET_KEY=dev-secret-change-me
APP_NAME=CloudPhoneBoard

# 数据库：本地用 SQLite 免 Docker；生产改成 Postgres
# DATABASE_URL=postgresql+psycopg2://cpb:cpb@localhost:5432/cpb
DATABASE_URL=sqlite:///cloud_phone.db

# JWT *（生产必须用强随机值）
JWT_SECRET=change-me-in-production-please
JWT_EXPIRE_HOURS=12

# 设备编排后端：simulator(免Docker) / redroid(真容器)
DEVICE_BACKEND=simulator

# 云手机服务器地址（承载 redroid/ADB 设备的物理服务器）
CLOUD_PHONE_SERVER=
CLOUD_PHONE_ADB_START_PORT=5555

# CORS：生产写死前端域名，不要用 *
CORS_ORIGINS=*

# 初始管理员
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@123456
SEED_SUPERADMIN_USERNAME=root
SEED_SUPERADMIN_PASSWORD=Root@123456


# ---- 云手机系统镜像（镜像管理功能，可选）----
# 平台侧镜像文件落盘目录 / docker 仓库名前缀 / 单次 docker 操作超时（秒）
IMAGE_STORE_DIR=instance/images
IMAGE_REPO_PREFIX=cpimg
IMAGE_DOCKER_TIMEOUT=1800
# 允许「重建目标设备」的破坏性部署（默认 false，勿轻易打开）
IMAGE_DEPLOY_REPLACE_ENABLED=false
# 真机（板子）分区镜像：允许操作的板子 SSH 地址清单（逗号分隔）
IMAGE_BOARD_HOSTS=
IMAGE_BOARD_USER=root
IMAGE_BOARD_KEY=
IMAGE_BOARD_PORT=22
